[dispersion]
# Please create a new account solely for using dispersion tools, which is
# helpful for keep your own data clean.
auth_url = http://localhost:8080/auth/v1.0
auth_user = test:tester
auth_key = testing
# auth_version = 1.0
#
# NOTE: If you want to use keystone (auth version 2.0), then its configuration
# would look something like:
# auth_url = http://localhost:5000/v2.0/
# auth_user = tenant:user
# auth_key = password
# auth_version = 2.0
#
# NOTE: If you want to use keystone (auth version 3.0), then its configuration
# would look something like:
# auth_url = http://localhost:5000/v3/
# auth_user = user
# auth_key = password
# auth_version = 3.0
# project_name = project
# project_domain_name = project_domain
# user_domain_name = user_domain
#
# endpoint_type = publicURL
#
# NOTE: If you have only 1 region with a swift endpoint, no need to specify it
# region_name =
#
# keystone_api_insecure = no
#
# swift_dir = /etc/swift
# Coverage to create, or additional percentage points with --no-overlap.
# Zero creates no samples; with --purge it removes the selected population.
# dispersion_coverage = 1.0
# retries = 5
# concurrency = 25
# container_populate = yes
# object_populate = yes
# container_report = yes
# object_report = yes
# policy_name = ec
# ^ storage policy name to report/populate; omit to use the default policy
#
# Write the report as Prometheus metrics to this file, for a collector such
# as the node_exporter textfile collector. Without it, the report writes no
# metrics file.
# metrics_filename = /var/lib/node_exporter/dispersion.prom
#
# Add the label user_cluster to every metric that the report writes.
# prom_user_label_cluster = mycluster

#
# To run an independent job for a ring, keep the shared authentication
# settings above and add a section with only the settings that differ. For
# example, use --section object-1 to report an object-1 ring:
#
# [object-1]
# container_report = no
# object_report = yes
# policy_name = unu
# metrics_filename = /var/lib/node_exporter/dispersion_unu.prom
#
# Every run replaces the whole metrics file. Two runs that share a
# metrics_filename keep only the metrics of the run that finished last.
# Give each run a different metrics_filename, in a section or in a
# separate conf file. A run selected with -P, --container-only or
# --object-only has no section, so it needs a separate conf file:
#
# swift-dispersion-report /etc/swift/dispersion.conf
# swift-dispersion-report -P ec /etc/swift/dispersion_ec.conf
#
# You can define as many sections as you have policies to report on; each
# run of swift-dispersion-report/-populate targets just the one section
# passed via --section:
#
# [object-ec]
# container_report = no
# object_report = yes
# policy_name = ec
# metrics_filename = /var/lib/node_exporter/dispersion_ec.prom
#
# Replace container samples with --container-only --purge. Replace object
# samples with --object-only --policy-name POLICY --purge. Each command deletes
# the selected samples and then populates canonical names. --purge and
# --no-overlap are mutually exclusive. Report and populate without --purge
# warn about obsolete names; report and --no-overlap count canonical samples.
# dump_json = no
